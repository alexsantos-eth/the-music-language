// SCALE
// C minor (c, d, eb, f, g, ab, bb)
setcpm(120/4)
const S = s("~")
const SCALE = 'c:minor'
const DURATION = 48

// BASELINE
const BASE_1 = note(`
    1 <1 0> <1 1 1 1*2> <0 2> 
  `.add(-7))
  .fast(2)
  .lpf("<500 700>")
  .room(0.4)
  .distort("1.5:0.12")
  .s("gm_electric_guitar_clean")
  .scale(SCALE)
  .color('blue')
  ._pianoroll()

const BASE_2 = sound("hh")
  .fast(4)
  .bank("rolandmc303")
  .color('red')
  ._scope()
  
const BASE_3 = sound("~ bd")
  .fast(4)
  .bank("rolandmc303")
  .color('green')
  ._scope()

const BASE_4 = n("<1 1 1*2 1> <1 1 1 [1 2]> <1 [1 3]> 2")
  .fast(2)
  .s("gm_marimba")
  .color('green')
  ._pianoroll()

const MELODY_1 = n(`<1 2> 2 <2 1> <2 3>`.add(12))
  .s("gm_choir_aahs")
  .scale(SCALE)
  .lpf("10000")
  .lpq("5")
  .room(2)
  .distort("3:0.1")
  .gain(0.1)
  ._pianoroll()

a1: arrange(
  [1, S],
  [3, BASE_1.lpf("100")],
  [2, BASE_1.euclid(5, 8)],
  [DURATION, BASE_1],
)._pianoroll()

a2: arrange(
  [4, BASE_2.gain(sine.range(0.1, 0.3))],
  [2, S],
  [DURATION, BASE_2]
)._pianoroll()

a3: arrange(
  [1, S],
  [3, BASE_4.euclid(3, 8)],
  [2, 
    BASE_4
    .euclid(5, 8)
    .room(0.4)],
  [DURATION, BASE_4]
)._pianoroll()

a4: arrange(
  [6, S],
  [DURATION, BASE_3]
)._pianoroll()

a5: arrange(
  [4, S],
  [2, MELODY_1.euclid(3, 8)],
  [DURATION, MELODY_1]
)._pianoroll()